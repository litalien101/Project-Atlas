{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Atlas Character Grammar v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "grammar_id", "revision", "anatomy_relationships", "shared_defaults", "archetypes", "evidence_policy"],
  "properties": {
    "schema": { "const": "atlas-character-grammar/v1" },
    "grammar_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,47}$" },
    "revision": { "type": "integer", "minimum": 1 },
    "anatomy_relationships": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["region", "relations", "surface_policy"],
        "properties": {
          "region": { "type": "string", "minLength": 1 },
          "relations": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "surface_policy": { "type": "string", "minLength": 1 },
          "review_status": { "enum": ["approved", "draft"] }
        }
      }
    },
    "shared_defaults": {
      "type": "object", "additionalProperties": false,
      "required": ["proportion_multipliers", "pose", "surface_style"],
      "properties": {
        "proportion_multipliers": { "$ref": "#/$defs/multipliers" },
        "pose": { "type": "string" },
        "surface_style": { "type": "string" }
      }
    },
    "archetypes": {
      "type": "object", "minProperties": 1, "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["proportion_multipliers", "silhouette_tags", "material_tags", "review_status", "evidence"],
        "properties": {
          "proportion_multipliers": { "$ref": "#/$defs/multipliers" },
          "silhouette_tags": { "type": "array", "items": { "type": "string" } },
          "material_tags": { "type": "array", "items": { "type": "string" } },
          "review_status": { "enum": ["approved", "draft"] },
          "evidence": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "evidence_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["reference_use", "minimum_reviewed_examples", "notes"],
      "properties": {
        "reference_use": { "const": "measurements_and_evidence_only" },
        "minimum_reviewed_examples": { "type": "integer", "minimum": 1 },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "multipliers": {
      "type": "object", "additionalProperties": { "type": "number", "minimum": 0.5, "maximum": 2.0 }
    }
  }
}
